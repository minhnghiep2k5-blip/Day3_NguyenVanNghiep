@model Day3_NguyenVanNghiep.Helpers.PaginatedList<Day3_NguyenVanNghiep.Models.Product>

@using System.Linq

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var categories =
        ViewBag.Categories as List<Day3_NguyenVanNghiep.Models.Category>;

    string searchTerm = ViewBag.SearchTerm as string ?? "";
    string sortOrder = ViewBag.SortOrder as string ?? "";
}

<h2 class="text-center mb-4">DANH SÁCH SẢN PHẨM</h2>

<!-- FORM TÌM KIẾM -->
<form asp-action="Index"
      method="get"
      class="mb-3">

    <div class="d-flex gap-2" style="max-width: 550px;">

        <input type="text"
               name="searchTerm"
               value="@searchTerm"
               class="form-control"
               placeholder="Tìm theo tên hoặc mô tả..." />

        <!-- Giữ lựa chọn sắp xếp -->
        <input type="hidden"
               name="sortOrder"
               value="@sortOrder" />

        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Làm mới
        </a>

    </div>
</form>

<!-- FORM SẮP XẾP -->
<form asp-action="Index"
      method="get"
      class="mb-3">

    <!-- Giữ từ khóa tìm kiếm -->
    <input type="hidden"
           name="searchTerm"
           value="@searchTerm" />

    <label class="form-label">
        <strong>Sắp xếp sản phẩm:</strong>
    </label>

    <select name="sortOrder"
            class="form-select"
            style="width: 280px;"
            onchange="this.form.submit()">

        <option value=""
                selected="@(sortOrder == "")">
            Mặc định (theo ID)
        </option>

        <option value="name_asc"
                selected="@(sortOrder == "name_asc")">
            Tên A → Z
        </option>

        <option value="name_desc"
                selected="@(sortOrder == "name_desc")">
            Tên Z → A
        </option>

        <option value="price_asc"
                selected="@(sortOrder == "price_asc")">
            Giá thấp → cao
        </option>

        <option value="price_desc"
                selected="@(sortOrder == "price_desc")">
            Giá cao → thấp
        </option>

    </select>

</form>

<!-- NÚT THÊM SẢN PHẨM -->
<p>
    <a asp-action="Create"
       class="btn btn-success">
        + Thêm sản phẩm mới
    </a>
</p>

<!-- THÔNG TIN SỐ LƯỢNG -->
<div class="mb-3">

    <p>
        Tổng số sản phẩm:
        <strong>@Model.TotalCount</strong>
    </p>

    <p>
        Trang:
        <strong>@Model.PageIndex / @Model.TotalPages</strong>
    </p>

    <p>
        Số sản phẩm mỗi trang:
        <strong>@Model.PageSize</strong>
    </p>

</div>

<!-- BẢNG SẢN PHẨM -->
<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Mô tả</th>
            <th>Danh mục</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Items != null && Model.Items.Any())
        {
            foreach (var item in Model.Items)
            {
                var catName = categories?
                .FirstOrDefault(c => c.Id == item.CategoryId)?.Name
                ?? "Không xác định";

                <tr>

                    <td>@item.Id</td>

                    <td>@item.Name</td>

                    <td>@item.Price.ToString("N0") VNĐ</td>

                    <td>@item.Description</td>

                    <td>@catName</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning">
                            Sửa
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-info">
                            Chi tiết
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Xóa
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    Không tìm thấy sản phẩm nào.
                </td>
            </tr>
        }

    </tbody>

</table>

<!-- PHÂN TRANG -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">

        <ul class="pagination">

            <!-- TRANG ĐẦU -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="1"
                   asp-route-searchTerm="@searchTerm"
                   asp-route-sortOrder="@sortOrder">
                    Đầu
                </a>

            </li>

            <!-- TRANG TRƯỚC -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@Model.PreviousPageIndex"
                   asp-route-searchTerm="@searchTerm"
                   asp-route-sortOrder="@sortOrder">
                    Trước
                </a>

            </li>

            <!-- CÁC SỐ TRANG -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-searchTerm="@searchTerm"
                       asp-route-sortOrder="@sortOrder">
                        @i
                    </a>

                </li>
            }

            <!-- TRANG SAU -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@Model.NextPageIndex"
                   asp-route-searchTerm="@searchTerm"
                   asp-route-sortOrder="@sortOrder">
                    Sau
                </a>

            </li>

            <!-- TRANG CUỐI -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages"
                   asp-route-searchTerm="@searchTerm"
                   asp-route-sortOrder="@sortOrder">
                    Cuối
                </a>

            </li>

        </ul>

    </nav>
}

}
